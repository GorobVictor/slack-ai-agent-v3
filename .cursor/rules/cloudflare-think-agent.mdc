# Ports and Adapters

When adding a new external dependency, create a port first.

Examples:

```ts
export interface ThinkSessionPort {
  submitUserMessage(input: SubmitUserMessageInput): Promise<SubmitUserMessageResult>;
}

export interface MessengerPort {
  sendMessage(input: SendMessageInput): Promise<void>;
  updateMessage?(input: UpdateMessageInput): Promise<void>;
}

export interface MemoryPort {
  get(key: string): Promise<string | null>;
  set(key: string, value: string): Promise<void>;
  delete(key: string): Promise<void>;
}

export interface VectorSearchPort {
  search(input: VectorSearchInput): Promise<VectorSearchResult[]>;
  upsert?(input: VectorUpsertInput): Promise<void>;
}

export interface FileStoragePort {
  getObject(key: string): Promise<ArrayBuffer | null>;
  putObject(key: string, value: ArrayBuffer, metadata?: Record<string, string>): Promise<void>;
  deleteObject(key: string): Promise<void>;
}
```

Use cases should depend only on ports.

Correct:

```txt
HandleSlackMessageUseCase → ThinkSessionPort → ThinkSessionAdapter
```

Incorrect:

```txt
HandleSlackMessageUseCase → @cloudflare/think concrete runtime
```

Incorrect:

```txt
HandleSlackMessageUseCase → env.THINK_AGENT
```

Adapters may depend on concrete APIs.

Use cases may not.

