{
  "name": "slack-ai-agent-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cmd/listener/index.ts",
    "listener:slack": "tsx src/cmd/listener/index.ts",
    "start": "node dist/cmd/listener/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "worker:deploy": "wrangler deploy",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "@cloudflare/shell": "^0.3.9",
    "@cloudflare/think": "^0.8.8",
    "@slack/bolt": "^4.7.3",
    "agents": "^0.15.0",
    "ai": "^6.0.198",
    "dotenv": "^17.4.2",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.1",
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
